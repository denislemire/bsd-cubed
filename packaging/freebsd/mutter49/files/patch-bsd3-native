+           gpointer task_data, GCancellable *cancellable)
+{
+  g_autoptr(GFileInputStream) stream = NULL;
+  g_autoptr(GdkPixbuf) decoded = NULL;
+  GdkPixbuf *oriented;
+  GError *error = NULL;
+
+  stream = g_file_read (source->file, cancellable, &error);
+  if (!stream)
+    {
+      g_task_return_error (task, error);
+      return;
+    }
+  decoded = gdk_pixbuf_new_from_stream (G_INPUT_STREAM (stream), cancellable, &error);
+  if (!decoded)
+    {
+      g_task_return_error (task, error);
+      return;
+    }
+  oriented = gdk_pixbuf_apply_embedded_orientation (decoded);
+  g_task_return_pointer (task, oriented, g_object_unref);
