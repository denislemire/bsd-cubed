+            this._currentSession = new ConsoleKitSession(Gio.DBus.system,
+                'org.freedesktop.ConsoleKit', objectPath);
+            return this._currentSession;
+        } catch (error) {
+            logError(error, 'Could not get a proxy for the current session');
+            return null;
+        }
+    }
