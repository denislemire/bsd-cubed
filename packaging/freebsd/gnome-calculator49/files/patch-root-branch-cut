+private void test_real_root_branch ()
+{
+    Number[] real_inputs = {
+        new Number.double (-4.0, 0.0),
+        new Number.double (-4.0, -0.0),
+        new Number.integer (4).invert_sign ()
+    };
+    foreach (var input in real_inputs)
+    {
+        var positive = input.root (2);
+        var negative = input.root (-2);
+        var power = input.xpowy (new Number.double (0.5));
+        if (!double_matches (positive.real_component (), 0.0) ||
+            !double_matches (positive.imaginary_component (), 2.0) ||
+            !double_matches (negative.real_component (), 0.0) ||
+            !double_matches (negative.imaginary_component (), -0.5) ||
+            !double_matches (power.real_component (), 0.0) ||
+            !double_matches (power.imaginary_component (), 2.0))
+        {
+            fail ("Real roots must use the principal branch for either sign of imaginary zero");
+            return;
+        }
+    }
+
+    // Nonzero imaginary components must retain their own side of the cut.
+    foreach (var sign in new int[] { -1, 1 })
+    {
+        var complex_root = new Number.double (-3.0, 4.0 * sign).root (2);
+        if (!double_matches (complex_root.real_component (), 1.0) ||
+            !double_matches (complex_root.imaginary_component (), 2.0 * sign))
+        {
+            fail ("Complex roots must preserve the side of the branch cut");
+            return;
+        }
+    }
     pass ();
 }
 
