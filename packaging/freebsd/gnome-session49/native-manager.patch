         return environment_updated;
 }
 
+#ifdef HAVE_BSD3_USER_SESSION
+static gboolean
+bsd3_update_environment (const char *name, const char *value, GError **error)
+{
+        int result = bsd3_session_setenv (name, value);
+        if (result < 0) {
+                g_set_error (error, G_IO_ERROR, g_io_error_from_errno (-result),
+                             "Native session environment update failed: %s", g_strerror (-result));
+                return FALSE;
+        }
+        return TRUE;
+}
+
+static gboolean
+bsd3_export_environment (GError **error)
+{
+        g_auto (GStrv) names = g_listenv ();
+        g_autoptr (GRegex) regex = g_regex_new ("^" ENV_NAME_PATTERN "$", 0, 0, error);
+        if (regex == NULL)
+                return FALSE;
+        for (guint i = 0; variable_blacklist[i] != NULL; i++)
+                if (!bsd3_update_environment (variable_blacklist[i], NULL, error))
+                        return FALSE;
+        for (guint i = 0; variable_unsetlist[i] != NULL; i++)
+                if (g_getenv (variable_unsetlist[i]) == NULL &&
+                    !bsd3_update_environment (variable_unsetlist[i], NULL, error))
+                        return FALSE;
+        for (guint i = 0; names[i] != NULL; i++) {
+                const char *name = names[i];
+                const char *value = g_getenv (name);
+                if (g_strv_contains (variable_blacklist, name) ||
+                    g_str_equal (name, "BSD3_SESSION_SOCKET") ||
+                    g_str_equal (name, "BSD3_READY_FD") ||
+                    g_str_has_prefix (name, "DINIT_") ||
+                    !g_regex_match (regex, name, 0, NULL) ||
+                    value == NULL || !g_utf8_validate (value, -1, NULL))
+                        continue;
+                if (!bsd3_update_environment (name, value, error))
+                        return FALSE;
+        }
+        return TRUE;
+}
+#endif
+
 gboolean
 gsm_util_export_user_environment (GError     **error)
 {
+#ifdef HAVE_BSD3_USER_SESSION
+        return bsd3_export_environment (error);
+#else
 
         GDBusConnection *connection;
         gboolean         environment_updated = FALSE;
@@ -390,6 +440,7 @@ gsm_util_export_user_environment (GError     **error)
         g_clear_object (&connection);
 
         return environment_updated;
+#endif
 }
 
 static gboolean
@@ -397,6 +448,9 @@ gsm_util_update_user_environment (const char  *variable,
                                   const char  *value,
                                   GError     **error)
 {
+#ifdef HAVE_BSD3_USER_SESSION
