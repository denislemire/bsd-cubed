         char            *entry;
@@ -437,7 +491,24 @@ gsm_util_update_user_environment (const char  *variable,
         g_clear_object (&connection);
 
         return environment_updated;
+#endif
+}
+
+#ifdef HAVE_BSD3_USER_SESSION
+gboolean
+gsm_util_setenv_native (const char *variable, const char *value, GError **error)
+{
+        if (!gsm_util_update_user_environment (variable, value, error))
+                return FALSE;
+        if (child_environment == NULL)
+                child_environment = g_get_environ ();
+        if (value == NULL)
+                child_environment = g_environ_unsetenv (child_environment, variable);
+        else
+                child_environment = g_environ_setenv (child_environment, variable, value, TRUE);
+        return gsm_util_update_activation_environment (variable, value, error);
 }
+#endif
 
