+
+#ifdef __FreeBSD__
+static gboolean
+set_up_for_new_vt (GdmSessionWorker *worker)
+{
+        char device[32], number[16];
+        int vt, fd;
+
+        fd = gdm_freebsd_vt_open (GDM_INITIAL_VT, worker->display_is_initial,
+                                  &vt, device, sizeof (device));
+        if (fd < 0)
+                return FALSE;
+        if (pam_set_item (worker->pam_handle, PAM_TTY, device) != PAM_SUCCESS) {
+                close (fd);
+                return FALSE;
+        }
+        worker->session_tty_fd = fd;
+        worker->session_vt = vt;
+        g_free (worker->display_device);
+        worker->display_device = g_strdup (device);
+        g_snprintf (number, sizeof (number), "%d", vt);
+        gdm_session_worker_set_environment_variable (worker, "XDG_VTNR", number);
+        return TRUE;
+}
+
+static gboolean
+set_up_ck_runtime (GdmSessionWorker *worker, const char *session_id)
+{
+        g_autoptr(GDBusConnection) bus = NULL;
+        g_autoptr(GVariant) reply = NULL;
+        const char *path;
+        struct stat st;
+
+        if (session_id == NULL)
+                return FALSE;
+        bus = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, NULL);
+        if (bus == NULL)
+                return FALSE;
+        reply = g_dbus_connection_call_sync (bus, CK_NAME, session_id,
+                                             CK_SESSION_INTERFACE, "GetXDGRuntimeDir",
+                                             NULL, G_VARIANT_TYPE ("(s)"),
+                                             G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                             3000, NULL, NULL);
+        if (reply == NULL)
+                return FALSE;
+        g_variant_get (reply, "(&s)", &path);
+        if (path[0] != '/' || lstat (path, &st) != 0 ||
+            !S_ISDIR (st.st_mode) || st.st_uid != worker->uid ||
+            (st.st_mode & 0777) != 0700)
+                return FALSE;
+        gdm_session_worker_set_environment_variable (worker, "XDG_RUNTIME_DIR", path);
+        return TRUE;
 }
 #endif
 
