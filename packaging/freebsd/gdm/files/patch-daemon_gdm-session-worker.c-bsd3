         g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(sv)"));
         g_variant_builder_add_parsed (&builder, "('unix-user', <%i>)", uid);
+#ifdef __FreeBSD__
+        /* A Wayland VT is not an X11 display. Advertising both an empty X11
+         * display and a nonempty X11 device makes ConsoleKit choose a dynamic
+         * seat, preventing correct activation and device control on seat0. */
+        g_variant_builder_add_parsed (&builder, "('x11-display-device', <%s>)",
+                                     g_strcmp0 (gdm_session_worker_get_environment_variable (
+                                             worker, "XDG_SESSION_TYPE"), "wayland") == 0
+                                             ? "" : display_device);
+        g_variant_builder_add_parsed (&builder, "('display-device', <%s>)", display_device);
+        if (worker->session_vt > 0 && worker->session_tty_fd >= 0)
+                g_variant_builder_add_parsed (&builder, "('vtnr', <%u>)",
+                                             (guint) worker->session_vt);
+#else
         g_variant_builder_add_parsed (&builder, "('x11-display-device', <%s>)", display_device);
+#endif
         g_variant_builder_add_parsed (&builder, "('x11-display', <%s>)", display_name);
         g_variant_builder_add_parsed (&builder, "('remote-host-name', <%s>)", display_hostname);
         g_variant_builder_add_parsed (&builder, "('is-local', <%b>)", worker->display_is_local);
